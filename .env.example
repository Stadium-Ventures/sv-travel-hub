# Heartbeat credentials. Optional: 1 = load Google sign-in on page load so
# Heartbeat calls carry the viewer's Google ID token; unset = sign-in only
# appears when Heartbeat answers 401.
# VITE_HEARTBEAT_SIGN_IN=1
# Server-only (never VITE_): Bearer the crons send to sv-heartbeat. Set in Vercel.
# HEARTBEAT_READ_TOKEN=

VITE_ROSTER_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?output=csv
VITE_SCHEDULE_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=SHEET_GID&single=true&output=csv
VITE_SUMMER_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?output=csv
# Optional second tab on the summer sheet for leagues without auto-fetch
# (Northwoods, Coastal Plain, NECBL/FCBL if Cloudflare-blocked).
# Columns: Player,Team,League,Date,Time,Home/Away,Opponent,Venue,VenueLat,VenueLng
VITE_SUMMER_MANUAL_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=SHEET_GID&single=true&output=csv
VITE_ORS_API_KEY=your_openrouteservice_api_key
# Contact card in the roster detail row (DOB/phone/email/parents). Leave unset:
# the roster load no longer carries contact data (decision D4 pending).
# VITE_CONTACT_CARD=1
